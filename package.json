{
  "name": "@chips/card-rich-text",
  "version": "1.0.0",
  "description": "Rich text card plugin for Chips ecosystem",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit && node scripts/post-build.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "chips",
    "card",
    "plugin",
    "rich-text"
  ],
  "author": "Chips Official",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/coverage-v8": "^1.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^13.3.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.0",
    "vue": "^3.4.15",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "vue": "^3.4.15"
  }
}
